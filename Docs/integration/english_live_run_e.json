      "phase": "rule",
      "message": "Draft rule web_dir_scan_distinct_paths (attempt 1 of 3).",
      "data": {
        "recipe": {
          "name": "web_dir_scan_distinct_paths",
          "attack_type": "web_dir_bruteforce",
          "parser": "nginx_access_parser",
          "filter": [
            {
              "field": "status",
              "op": "eq",
              "value": 404
            }
          ],
          "aggregation": {
            "skill": "distinct_count_window",
            "params": {
              "group_by": "src_ip",
              "distinct_field": "path",
              "window_s": 60
            }
          },
          "condition": {
            "field": "distinct_count",
            "op": "gte",
            "value": 5
          },
          "description": "Alert when one source IP requests at least 5 distinct paths returning 404 within 60 seconds, indicating directory scanning."
        },
        "attempt": 1,
        "max_attempts": 3,
        "explanation": "The recipe parses nginx access logs and keeps only 404 responses. It counts distinct paths per source IP in a 60-second sliding window and alerts at 5 or more. In the sample, normal clients make isolated 404s spread over many minutes, while the scanner hits 5 distinct paths within about 10 seconds."
      }
    },
