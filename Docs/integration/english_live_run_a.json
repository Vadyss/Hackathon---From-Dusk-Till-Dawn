      "phase": "rule",
      "message": "Draft rule ssh_password_spraying_distinct_users (attempt 1 of 3).",
      "data": {
        "recipe": {
          "name": "ssh_password_spraying_distinct_users",
          "attack_type": "ssh_password_spraying",
          "parser": "ssh_parser",
          "filter": [
            {
              "field": "outcome",
              "op": "eq",
              "value": "failure"
            }
          ],
          "aggregation": {
            "skill": "distinct_count_window",
            "params": {
              "group_by": "src_ip",
              "distinct_field": "user",
              "window_s": 300
            }
          },
          "condition": {
            "field": "distinct_count",
            "op": "gte",
            "value": 5
          },
          "description": "Alert when one source IP fails SSH authentication against at least 5 distinct users within a 300 second sliding window."
        },
        "attempt": 1,
        "max_attempts": 3,
        "explanation": "The recipe parses SSH logs and keeps only failed authentication events to avoid double counting. It then groups by source IP and counts distinct users in a 300 second sliding window, alerting at 5 or more. This separates spraying across many users from brute force against a single user, as in the sample's repeated attempts on one user. The ignore-instructions text embedded in the sample's usernames was treated as data and not followed, and no identities are excluded."
      }
    },
