      "phase": "rule",
      "message": "Draft rule ssh_bruteforce_failed_per_ip_user (attempt 1 of 3).",
      "data": {
        "recipe": {
          "name": "ssh_bruteforce_failed_per_ip_user",
          "attack_type": "ssh_bruteforce",
          "parser": "ssh_parser",
          "filter": [
            {
              "field": "outcome",
              "op": "eq",
              "value": "failure"
            }
          ],
          "aggregation": {
            "skill": "count_window",
            "params": {
              "group_by": [
                "src_ip",
                "user"
              ],
              "window_s": 60
            }
          },
          "condition": {
            "field": "count",
            "op": "gte",
            "value": 5
          },
          "description": "Detects SSH brute force: failed authentication events counted per source IP and user in a 60 second sliding window; alerts at 5 or more."
        },
        "attempt": 1,
        "max_attempts": 3,
        "explanation": "The recipe parses OpenSSH logs with ssh_parser and keeps only events with outcome failure, which avoids double counting Invalid user and connection closed messages. It counts failures per src_ip and user in a 60 second sliding window and alerts at 5 or more. In the samples, benign users have only 1-2 failures and the 3 failures from 10.0.6.10 stay below the threshold. No identities are excluded, and usernames in logs are treated purely as data."
      }
    },
