      "data": {
        "recipe": {
          "name": "ssh_bruteforce_failed_count",
          "attack_type": "ssh_bruteforce",
          "parser": "ssh_parser",
          "filter": [
            {
              "field": "outcome",
              "op": "eq",
              "value": "failure"
            }
          ],
          "aggregation": {
            "skill": "count_window",
            "params": {
              "group_by": [
                "src_ip",
                "user"
              ],
              "window_s": 60
            }
          },
          "condition": {
            "field": "count",
            "op": "gte",
            "value": 6
          },
          "description": "Alert when one source IP produces at least 6 failed SSH authentication attempts against one user within 60 seconds."
        },
        "attempt": 1,
        "max_attempts": 3,
        "explanation": "The recipe parses SSH logs, keeps only failed authentication events (outcome eq failure) to avoid double counting, and counts them per source IP and user in a 60 second sliding window. A threshold of 6 is above the small bursts of 2-3 failures seen in benign sample traffic, while still catching sustained brute force. No identities are excluded."
      }
    },
