      "message": "Draft rule ssh_distributed_bruteforce_detect (attempt 1 of 3).",
      "data": {
        "recipe": {
          "name": "ssh_distributed_bruteforce_detect",
          "attack_type": "ssh_distributed_bruteforce",
          "parser": "ssh_parser",
          "filter": [
            {
              "field": "outcome",
              "op": "eq",
              "value": "failure"
            }
          ],
          "aggregation": {
            "skill": "distinct_count_window",
            "params": {
              "group_by": "user",
              "distinct_field": "src_ip",
              "window_s": 300
            }
          },
          "condition": {
            "field": "distinct_count",
            "op": "gte",
            "value": 5
          },
          "description": "Alert when at least 5 distinct source IPs fail SSH authentication against the same user within 300 seconds."
        },
        "attempt": 1,
        "max_attempts": 3,
        "explanation": "The recipe parses SSH logs and keeps only failed authentication events. It counts distinct src_ip values per user in a 300-second sliding window and alerts at 5 or more. The sample shows normal failures coming from one IP per user, so this threshold should not fire on them. No identities are excluded, and the instruction-like text in the sample usernames was treated as data and ignored."
      }
    },
