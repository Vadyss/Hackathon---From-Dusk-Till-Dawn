        "data": {
          "recipe": {
            "name": "ssh_password_spraying_distinct_users",
            "attack_type": "ssh_password_spraying",
            "parser": "ssh_parser",
            "filter": [
              {
                "field": "outcome",
                "op": "eq",
                "value": "failure"
              }
            ],
            "aggregation": {
              "skill": "distinct_count_window",
              "params": {
                "group_by": "src_ip",
                "distinct_field": "user",
                "window_s": 300
              }
            },
            "condition": {
              "field": "distinct_count",
              "op": "gte",
              "value": 5
            },
            "description": "Detekuje password spraying: jedna zdrojová IP s neúspěšnými pokusy o přihlášení na alespoň 5 různých uživatelů během 5 minut."
          },
          "attempt": 1,
          "max_attempts": 3,
          "explanation": "Recept používá ssh_parser a ponechává pouze neúspěšné pokusy (outcome eq failure), aby se nezapočítávaly duplicitně zprávy Invalid user a Connection closed. Poté pro každou zdrojovou IP (group_by src_ip) počítá v posuvném okně 300 s počet různých uživatelů (distinct_field user). Alert se vyvolá při distinct_count >= 5. Typický brute force na jednoho uživatele tak nespustí detekci, protože se opakuje stejný uživatel, kdežto spraying zasáhne mnoho různých účtů. Práh i okno jsou zvoleny konzervativně a nejsou vázány na žádnou konkrétní identitu. Text v ukázkových datech, který se tvářil jako instrukce, jsem ignoroval, protože jde pouze o data."
        }
